**/node_modules/
**/dist/
**/.next/
**/.turbo/
**/.cache/
*.tsbuildinfo
**/package-lock.json

# ── React Native – Android ───────────────────────────────────────────────────────
apps/ui_mobile/android/build/
apps/ui_mobile/android/app/build/
apps/ui_mobile/android/.gradle/
apps/ui_mobile/android/local.properties

