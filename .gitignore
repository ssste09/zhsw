apps/ui_mobile/ios/build/
apps/ui_mobile/ios/Pods/
apps/ui_mobile/ios/*.xcworkspace/

# ── Environment / secrets ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

